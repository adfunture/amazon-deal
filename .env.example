# SBC AI Sourcing Intelligence – Umgebungsvariablen
# Lokal: nach apps/backend/.env bzw. apps/frontend/.env.local kopieren.
# Railway: im Dashboard je Service setzen. Datenbank-, Redis- und Bucket-Werte kommen über
# Referenzvariablen aus .railway/railway.ts und müssen NICHT manuell eingetragen werden.

# ---------------------------------------------------------------- Allgemein (backend/worker/scheduler)
APP_ENV=development                 # development | staging | production
APP_SECRET=                         # mind. 32 Zeichen, z. B. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000  # für CORS; auf Railway: https://<frontend-domain>
BACKEND_URL=http://localhost:8000   # öffentliche Backend-URL (nur Doku/Links, z. B. für n8n)
CORS_ORIGINS=                       # weitere erlaubte Origins, kommagetrennt

# ---------------------------------------------------------------- Datenbank & Queue
DATABASE_URL=postgresql://sbc:sbc@localhost:5432/sbc   # Railway: ${{Postgres.DATABASE_URL}}
REDIS_URL=redis://localhost:6379/0                     # Railway: ${{Redis.REDIS_URL}}

# ---------------------------------------------------------------- Erster Admin (nur wenn noch kein Nutzer existiert)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=             # mind. 10 Zeichen; nach erstem Login im Railway-Dashboard löschen
INITIAL_ORG_NAME=SBC symbio GmbH & Co. KG

# ---------------------------------------------------------------- Objektspeicher (Railway Bucket, S3-kompatibel)
STORAGE_BACKEND=s3                  # s3 | local (local nur Entwicklung, in Produktion gesperrt)
S3_ENDPOINT=                        # Railway Bucket: ENDPOINT
S3_BUCKET=                          # Railway Bucket: BUCKET (nicht RAILWAY_BUCKET_NAME)
S3_ACCESS_KEY=                      # Railway Bucket: ACCESS_KEY_ID
S3_SECRET_KEY=                      # Railway Bucket: SECRET_ACCESS_KEY
S3_REGION=auto                      # Railway Bucket: REGION
S3_FORCE_PATH_STYLE=false           # nur für ältere Buckets mit Path-Style
LOCAL_STORAGE_DIR=./.data/storage
FILE_RETENTION_DAYS=180             # Löschfrist für Importdateien (Scheduler)
MAX_UPLOAD_MB=100
CLAMAV_HOST=                        # optional: clamd für Malware-Scan der Uploads
CLAMAV_PORT=3310

# ---------------------------------------------------------------- KI
ANTHROPIC_API_KEY=                  # Claude API (Matching-Prüfung Text/Bild)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low                      # low | medium | high – Kosten/Tiefe der KI-Prüfung
OPENAI_API_KEY=                     # optional, Provider-Schnittstelle vorbereitet (noch nicht verdrahtet)

# ---------------------------------------------------------------- Marktplätze
KEEPA_API_KEY=                      # Keepa API Access Key
KEEPA_CACHE_TTL_HOURS=12
# Amazon SP-API (Phase 4): JSON mit LWA-Daten, Region EU
# {"client_id":"amzn1.application-oa2-client...","client_secret":"...","refresh_token":"Atzr|...","seller_id":"...","region":"eu"}
AMAZON_SP_API_CREDENTIALS=
EBAY_CLIENT_ID=                     # Phase 4: eBay Browse API (OAuth Client Credentials)
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production

# ---------------------------------------------------------------- Berichte (E-Mail standardmäßig AUS)
SMTP_URL=                           # smtp://user:pass@smtp.example.com:587
REPORT_RECIPIENTS=                  # einkauf@example.com,leitung@example.com

# ---------------------------------------------------------------- Scheduler-Overrides (optional)
# SCHEDULE_REANALYZE_STALE=0 */6 * * *
# SCHEDULE_DAILY_REPORT=off

# ---------------------------------------------------------------- Frontend (apps/frontend)
# BACKEND_URL=http://localhost:8000          # lokal
# BACKEND_HOST=${{backend.RAILWAY_PRIVATE_DOMAIN}}   # Railway Private Networking
# BACKEND_PORT=8000
